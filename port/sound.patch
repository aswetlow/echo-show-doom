diff --git a/doomgeneric/src/i_wasmsound.c b/doomgeneric/src/i_wasmsound.c
new file mode 100644
index 0000000..35dd4e2
--- /dev/null
+++ b/doomgeneric/src/i_wasmsound.c
@@ -0,0 +1,95 @@
+//
+// echo-show-doom: sound effects for doom.wasm.
+//
+// Doom's sound code (s_sound.c) decides which effect to play, on which of its channels, with which
+// volume and stereo separation. This module hands that to the host (JavaScript) through four imports
+// in the "sound" import module. The host decodes the raw DMX lump and plays it with Web Audio.
+// Music is not implemented.
+//
+// License: GPL-2.0-or-later, like the rest of Doom.
+//
+
+#include "doomtype.h"
+#include "i_sound.h"
+#include "m_misc.h"
+#include "w_wad.h"
+#include "z_zone.h"
+#include "deh_str.h"
+
+#define SOUND_IMPORT(name) __attribute__((import_module("sound"), import_name(name)))
+
+// Start effect `lumpnum` (raw DMX lump at data/length) on `channel`. vol 0..127, sep 0..254 (128 = centre).
+SOUND_IMPORT("startSfx") void host_startSfx(int channel, int lumpnum, const byte *data, int length, int vol, int sep);
+SOUND_IMPORT("stopSfx") void host_stopSfx(int channel);
+SOUND_IMPORT("updateSfx") void host_updateSfx(int channel, int vol, int sep);
+SOUND_IMPORT("isPlaying") int host_isPlaying(int channel);
+
+static boolean use_sfx_prefix;
+
+static snddevice_t sound_wasm_devices[] = {
+    SNDDEVICE_SB, SNDDEVICE_PAS, SNDDEVICE_GUS, SNDDEVICE_WAVEBLASTER, SNDDEVICE_SOUNDCANVAS, SNDDEVICE_AWE32,
+};
+
+static boolean I_Wasm_InitSound(boolean _use_sfx_prefix) {
+  use_sfx_prefix = _use_sfx_prefix;
+  return true;
+}
+
+static void I_Wasm_ShutdownSound(void) {}
+
+static int I_Wasm_GetSfxLumpNum(sfxinfo_t *sfx) {
+  char namebuf[9];
+
+  if (sfx->link != NULL) {
+    sfx = sfx->link;
+  }
+  if (use_sfx_prefix) {
+    M_snprintf(namebuf, sizeof(namebuf), "ds%s", DEH_String(sfx->name));
+  } else {
+    M_StringCopy(namebuf, DEH_String(sfx->name), sizeof(namebuf));
+  }
+  // W_CheckNumForName instead of W_GetNumForName: a missing sound must not end the game.
+  return W_CheckNumForName(namebuf);
+}
+
+static void I_Wasm_UpdateSound(void) {}
+
+static void I_Wasm_UpdateSoundParams(int channel, int vol, int sep) {
+  host_updateSfx(channel, vol, sep);
+}
+
+static int I_Wasm_StartSound(sfxinfo_t *sfx, int channel, int vol, int sep) {
+  int lumpnum = sfx->lumpnum;
+
+  if (lumpnum < 0) {
+    return -1;
+  }
+  // The lump stays cached in the zone, so the pointer is valid while the host decodes it.
+  byte *data = W_CacheLumpNum(lumpnum, PU_STATIC);
+  host_startSfx(channel, lumpnum, data, W_LumpLength(lumpnum), vol, sep);
+  return channel;
+}
+
+static void I_Wasm_StopSound(int channel) {
+  host_stopSfx(channel);
+}
+
+static boolean I_Wasm_SoundIsPlaying(int channel) {
+  return host_isPlaying(channel) != 0;
+}
+
+static void I_Wasm_PrecacheSounds(sfxinfo_t *sounds, int num_sounds) {}
+
+sound_module_t sound_wasm_module = {
+    sound_wasm_devices,
+    arrlen(sound_wasm_devices),
+    I_Wasm_InitSound,
+    I_Wasm_ShutdownSound,
+    I_Wasm_GetSfxLumpNum,
+    I_Wasm_UpdateSound,
+    I_Wasm_UpdateSoundParams,
+    I_Wasm_StartSound,
+    I_Wasm_StopSound,
+    I_Wasm_SoundIsPlaying,
+    I_Wasm_PrecacheSounds,
+};
